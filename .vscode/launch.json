{
  // Configuración de depuración para VS Code - Proyecto Web Vanilla (HTML, CSS, JS)
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Depurar en Chrome (Live Server - localhost:5500)",
      "url": "http://127.0.0.1:5500/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "Depurar en Edge (Live Server - localhost:5500)",
      "url": "http://127.0.0.1:5500/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "firefox",
      "request": "launch",
      "name": "Depurar en Firefox (Live Server - localhost:5500)",
      "url": "http://127.0.0.1:5500/index.html",
      "webRoot": "${workspaceFolder}",
      "pathMappings": [
        {
          "url": "http://127.0.0.1:5500",
          "path": "${workspaceFolder}"
        }
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Abrir index.html local directo (Chrome)",
      "file": "${workspaceFolder}/index.html",
      "webRoot": "${workspaceFolder}"
    }
  ]
}